# Copy to cloud.env, replace the service key with the same value configured on TokenNest.
TOKENBIRD_CLOUD_SERVICE_KEY=replace-with-a-random-secret-at-least-32-characters
# Independent admin login key, at least 32 characters and different from the service key.
# Leave empty to disable admin login. Never send either key to ordinary users.
TOKENBIRD_CLOUD_ADMIN_KEY=
TOKENNEST_URL=https://openai.goldgom.top
TOKENBIRD_CLOUD_PUBLIC_URL=https://agent.tokenbird.goldgom.top
TOKENBIRD_CLOUD_HOST=127.0.0.1
TOKENBIRD_CLOUD_PORT=8080
TOKENBIRD_CLOUD_DATA_DIR=./data
TOKENBIRD_CLOUD_WEBUI_DIR=./webui
# Prefer encrypted peer-to-peer RPC; failed NAT traversal uses the existing relay.
TOKENBIRD_CLOUD_DIRECT_ENABLED=true
# STUN only; set [] for LAN/IPv6 direct access without an external STUN service.
TOKENBIRD_CLOUD_STUN_SERVERS='[{"urls":"stun:stun.cloudflare.com:3478"}]'
