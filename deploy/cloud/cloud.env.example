# Copy to cloud.env, replace the service key with the same value configured on TokenNest.
TOKENBIRD_CLOUD_SERVICE_KEY=replace-with-a-random-secret-at-least-32-characters
TOKENNEST_URL=https://openai.goldgom.top
TOKENBIRD_CLOUD_PUBLIC_URL=https://agent.tokenbird.goldgom.top
TOKENBIRD_CLOUD_HOST=127.0.0.1
TOKENBIRD_CLOUD_PORT=8080
TOKENBIRD_CLOUD_DATA_DIR=./data
TOKENBIRD_CLOUD_WEBUI_DIR=./webui
