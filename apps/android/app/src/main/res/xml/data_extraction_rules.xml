<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Server profiles can contain access tokens; never copy app data to a
         cloud backup or another device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
