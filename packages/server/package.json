{
  "name": "@tokenbird/server",
  "version": "26.10.20",
  "description": "Standalone headless TokenBird server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "tokenbird-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "TokenNest"
  },
  "license": "Apache-2.0",
  "homepage": "https://openai.goldgom.top",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tokenbird/core": "workspace:*",
    "@tokenbird/messaging-gateway": "workspace:*",
    "@tokenbird/server-core": "workspace:*",
    "@tokenbird/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
